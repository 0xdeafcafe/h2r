// Signing and identity for the tvOS app (docs/tvos.md). Put your own
// values in Local.xcconfig next to this file (not committed), e.g.
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   PRODUCT_BUNDLE_IDENTIFIER = com.example.h2recomp
//
// or pass them to xcodebuild on the command line.
PRODUCT_BUNDLE_IDENTIFIER = red.forbes.h2recomp.tv
PRODUCT_NAME = H2TV
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development

#include? "Local.xcconfig"
