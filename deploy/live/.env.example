# Copy to .env (never committed) and fill in. docs/live/live-hosting.md,
# "Docker with a named tunnel" and "Free hosting".

# The tunnel's token: Cloudflare dashboard > Zero Trust > Networks > Tunnels >
# your tunnel > the install command's long `eyJ...` string.
TUNNEL_TOKEN=

# Gamertags that are admins (comma-separated). Create these accounts right
# after the first start: whoever registers one first is an admin.
H2_LIVE_ADMINS=

# The address the tunnel serves; its host becomes the server id on the
# first start and can never change after.
H2_LIVE_PUBLIC_URL=https://live.forbes.red

# Where the server's state (key, id, live.db, blobs on disk) and the
# extracted art live on this machine.
H2_LIVE_DATA_DIR=./data
H2_LIVE_ART_DIR=./art

# --- Cloudflare R2 (optional; blank: everything stays in ./data) ---------
# R2 > Overview: the S3 API endpoint, https://<account id>.r2.cloudflarestorage.com
H2_LIVE_S3_ENDPOINT=
# R2 > Manage API tokens > Create API token (Object Read & Write, these buckets).
H2_LIVE_S3_ACCESS_KEY_ID=
H2_LIVE_S3_SECRET_ACCESS_KEY=
# The private bucket: content and cloud saves (and Litestream's backups).
# H2_LIVE_BLOBS=s3://h2live
# A second, public bucket the shared game art is published to, and the
# address it is public at (its custom domain, or the r2.dev URL).
# H2_LIVE_PUBLIC_BLOBS=s3://h2live-public
# H2_LIVE_PUBLIC_BLOBS_URL=https://art.forbes.red
# Continuous backup of live.db to the private bucket with Litestream.
# COMPOSE_PROFILES=backup
# LITESTREAM_BUCKET=h2live

# The log in Postgres instead of SQLite: run with compose.postgres.yaml and
# set a password (letters and digits only: openssl rand -hex 24).
# POSTGRES_PASSWORD=

# Linux only: your uid/gid (id -u, id -g), so ./data stays yours.
# H2_LIVE_UID=1000
# H2_LIVE_GID=1000

# Pin cloudflared or Litestream if you like.
# CLOUDFLARED_VERSION=2026.10.0
# LITESTREAM_VERSION=0.3
