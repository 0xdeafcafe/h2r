# Copy to .env (never committed) and fill in. docs/live-hosting.md,
# "Docker with a named tunnel".

# The tunnel's token: Cloudflare dashboard > Zero Trust > Networks > Tunnels >
# your tunnel > the install command's long `eyJ...` string.
TUNNEL_TOKEN=

# The database password; letters and digits only (it goes in a URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Gamertags that are admins (comma-separated). Create these accounts right
# after the first start: whoever registers one first is an admin.
H2_LIVE_ADMINS=

# The address the tunnel serves; its host becomes the server id on the
# first start and can never change after.
H2_LIVE_PUBLIC_URL=https://live.forbes.red

# Where the server's state and the extracted art live on this machine.
H2_LIVE_DATA_DIR=./data
H2_LIVE_ART_DIR=./art

# Linux only: your uid/gid (id -u, id -g), so ./data stays yours.
# H2_LIVE_UID=1000
# H2_LIVE_GID=1000

# Pin cloudflared if you like (default: latest).
# CLOUDFLARED_VERSION=2026.10.0
