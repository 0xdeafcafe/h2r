// Glitch Hunt: explore the maps with a sword and rockets, no score and no
// clock. docs/game/community-gametypes.md.
rules "Glitch Hunt" 1
type research
uses slayer
about "Explore the maps and find their secrets: sword flying, rocket and grenade jumps, tough players, no score and no clock."
quick starting_weapon, secondary_weapon, shields, damage_resistance, time_limit

settings {
    score_limit = none
    time_limit = none
    respawn_time = 3s
    suicide_penalty = 0s
    shields = overshields
    damage_resistance = true
    starting_weapon = energy_sword
    secondary_weapon = rocket_launcher
    friendly_fire = false
}
