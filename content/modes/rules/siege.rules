// Siege: the phased attack-and-defend mode, with the mechanics of Halo:
// Reach's Invasion and none of its assets or text. A game is `round_count`
// rounds, and the sides swap at each: team 0 attacks in the first, team 1
// in the second, and so on. The round's winners score a point each and
// the scores carry on; the side that won the more rounds wins the game,
// and an even count draws it. A round ends on the objective or on the
// clock (`next_round`, `game.rounds`), the last one ends the game
// (`end_round`), and each opens with its number on the banner. The map's
// own flags are the objectives, so a map needs no kit:
// the attackers take `sites` of its territories (any of them, each held
// alone for the capture time in all), then hold the defenders' CTF flag
// stand for the capture time to win. A map with no flag stand stops at
// the sites: taking them all wins it. Each phase has its own clock; the
// defenders win when one runs out. Each side spawns with its own loadout,
// and its dead come back together in waves: the variant's one life holds
// a death's respawn, and the side's wave timer releases it. Each side
// spawns near its line, which moves with the phases (`spawn_near`): the
// attackers at their own flag stand, then at the last site they took; the
// defenders at a site still to take, then at their flag stand. The
// attackers spawn as Spartans and the defenders as Elites (`set_body`).
// The winners score a point each, so the post-game's scores name them.
// Each side's bots go for the front the HUD marks: the attackers' take
// it and the defenders' hold it (`bots.orders`: `bot_goal_attack`,
// `bot_goal_defend`).
// Each side's objective line, the phase clock, the capture gauge and the mark
// over the front are the scripted objective HUD's (`hud.objective`:
// `objective`, `countdown`, `meter`, `objective_mark`).
// The rest of the HUD is the King of the Hill kit's: a mark over the site the attackers
// are on (else the first still to take, then the final stand), its state
// (open, held by a side, contested), the seconds the phase has left
// (`koth.phase`), and a banner for a site taken, the final assault, an
// overtime and the last 30 and 10 seconds of a phase.
// A phase whose clock runs out with an attacker on its objective goes into
// overtime: the defenders win when the attackers leave it, or when the
// overtime runs out, whichever is first, and a capture that completes
// first takes the site as it would have.
// The map opens with the phases: each `siege_barrier` object, numbered by
// the phase it opens in, stands open from that phase on (`set_open`).
// Each side has a table of loadout rows, lightest first, and a player picks
// a row of their side before a spawn: `offer` opens the rows of the
// phase's tier to them (the host asks, a select dialog) and `choice` reads
// the one they last picked, row 0 until they pick. A player who picks
// nothing keeps the last row; a heavier row opens with each phase.
// A map with a layout (`rules::builtin::layout`, or a map variant that
// labels the same things) plays ordered phases: its `siege_site` flags are
// numbered by phase, only a site numbered for the phase counts (a later
// phase's site held early does nothing) and either site of a phase
// advances it. Its starting locations are labelled `siege_attack` and
// `siege_defend`, numbered by phase, and each phase's spawns are the
// starts of its number (`spawn_areas`), the final assault's being the last
// number. Each phase from the second opens a heavier loadout tier to
// both sides to pick from. A map with no numbered site plays as the lines
// above say: any sites in any order, spawns near them, the first tier.
// docs/game/rules-engine.md, "Phases: attack and defend" (the Siege
// section) and "Payoff".
//
// Entries a host cannot make yet (`verify::unhostable`): none.
rules "Siege" 1
type siege
teams 2
requires player.weapons, player.spawn, player.disguise, player.pick, hud.message, hud.widgets, hud.waypoints, hud.objective, objects.move, game.rounds, bots.orders
about "Attackers take the map's territories, then storm the defenders' flag stand. Each phase has its own clock: run it out and the defenders win."
quick respawn_time, wave_time, phase_time, capture_time, sites

// Players spawn unarmed and `on spawn` gives each side its loadout, so
// the spawn's own weapons are never made and dropped. One life a round
// holds each death's respawn back, so a side's dead wait for its wave.
settings {
    team_play = true
    score_limit = none
    time_limit = none
    lives = 1
    starting_weapon = none
    secondary_weapon = none
}

// What the map supplies, when it has it. The author's places come first
// (docs/game/game-types-without-carriers.md, "Maps for scripted games"):
// `siege_site` flags are the sites (the map's territory flags when none
// is placed, `rules::labels::reads`), a `siege_goal` is the final stand
// (each team's CTF flag stand when none is placed), and `siege_line`
// flags, numbered by phase and given a team (0 the attackers, 1 the
// defenders, whichever team that is in the round), are where a side spawns in
// that phase (the phase's own site or stand when none is placed), and
// `siege_barrier` objects, numbered by the phase they open in (a barrier
// numbered 0 is open from the start). The script requires no label of its
// own, but the lobby's start gate (`rules::gate`) refuses a map with no
// site and no final stand: with no site the assault goes straight to the
// stand, with no stand the sites are the whole assault, and a run the gate
// does not guard (a scenario) with neither draws the round at its start. A line or barrier label is bounded, so the lookups
// of a tick stay small.
label site: zones = "siege_site"
label goal: zone? = "siege_goal"
label base: zones = "ctf_flag_spawn"
label placed_line: zones at most 16 = "siege_line"
label barrier: objects at most 8 = "siege_barrier"
// A layout's starting locations, numbered by phase.
label siege_attack: spawns
label siege_defend: spawns

option phase_time: time 60s..600s = 180s "Phase time" "How long the attackers have for each phase"
option capture_time: time 5s..60s = 15s "Capture time" "How long the attackers hold a site or the flag stand alone to take it"
option sites: int 1..4 = 2 "Sites" "How many territories the attackers take before the final assault"
option wave_time: time 3s..30s = 10s "Respawn wave" "How long a side's dead wait to come back together"
option overtime_time: time 5s..60s = 30s "Overtime" "The most a phase runs on past its clock while an attacker is on its objective"
option round_count: int 1..8 = 2 "Rounds" "How many rounds; the sides swap at each"

// The HUD (docs/game/game-types-without-carriers.md, "The display"): the
// front's state, a banner, and a mark over the front.
hud front_row: text at koth.hill
hud banner_row: banner at koth.banner
hud phase_row: text at koth.phase
waypoint front_mark at koth.mark

// How many starting locations a side's spawns keep near its line.
const line = 4

// Each side's loadout rows, lightest first: the rows a phase opens are the
// first of them (`tier_rows`). Row 0 is the default.
table attack_rows: (primary: weapon, secondary: weapon) = [
    ("objects/weapons/rifle/battle_rifle/battle_rifle", "objects/weapons/pistol/magnum/magnum"),
    ("objects/weapons/rifle/shotgun/shotgun", "objects/weapons/pistol/magnum/magnum"),
    ("objects/weapons/rifle/beam_rifle/beam_rifle", "objects/weapons/pistol/plasma_pistol/plasma_pistol"),
    ("objects/weapons/rifle/sniper_rifle/sniper_rifle", "objects/weapons/rifle/smg/smg"),
    ("objects/weapons/melee/energy_blade/energy_blade", "objects/weapons/rifle/covenant_carbine/covenant_carbine"),
]

table defend_rows: (primary: weapon, secondary: weapon) = [
    ("objects/weapons/rifle/covenant_carbine/covenant_carbine", "objects/weapons/rifle/plasma_rifle/plasma_rifle"),
    ("objects/weapons/rifle/brute_plasma_rifle/brute_plasma_rifle", "objects/weapons/pistol/needler/needler"),
    ("objects/weapons/rifle/sniper_rifle/sniper_rifle", "objects/weapons/pistol/magnum/magnum"),
    ("objects/weapons/rifle/beam_rifle/beam_rifle", "objects/weapons/pistol/plasma_pistol/plasma_pistol"),
    ("objects/weapons/support_high/rocket_launcher/rocket_launcher", "objects/weapons/rifle/battle_rifle/battle_rifle"),
]

// How many rows each side may pick from in a tier: the tier is the phase
// (the first, the second, the final assault).
table tier_rows: (attack: int, defend: int) = [
    (2, 2),
    (4, 4),
    (5, 5),
]

// The rounds played before this one, and the round's sides. They carry
// across rounds: `on round_start` sets the sides from the count.
global var round: int = 0
global var attackers: team = team 0
global var defenders: team = team 1
// The rounds each team has won.
team var wins: int = 0
// The phases taken so far, and how many sites come before the final one.
global var phase: int = 0
// The row of its side's table each player's kit was last set from.
player var kit: int = -1
// The loadout tier the phase opens: 0 on a map with no numbered sites.
global var tier: int = 0
global var advanced: bool = false
// Whether the map's sites are numbered by phase (a layout), and how many
// phases of sites it has.
global var ordered: bool = false
global var top: int = 0
global var needed: int = 0
global var clock: timer
global var over: bool = false
// Whether the phase is past its clock with an attacker still on its
// objective, and how many attackers were on the front last tick.
global var overtime: bool = false
global var pushers: int = 0
// The defenders' final stand: the placed goal, else their flag stand.
global var last_stand: zone? = none
// Whether the map gives the attackers a flag stand to storm.
global var assault: bool = false
// Each side's respawn wave, running while that side has dead to bring
// back.
global var wave0: timer
global var wave1: timer
object var taken: bool = false
// Whether the site shows its boundary: at most six do, so the sites and
// the final stand fit the eight areas a script may show.
object var lit: bool = false
global var lights: int = 0
// The site taken this tick, if any, whose line the spawns move to.
global var front: zone? = none
// The zone the HUD follows, the banner's ticks left, and the last whole
// second of the clock a warning was weighed at.
global var focus: zone? = none
global var banner_left: int = 0
global var seen: int = -1
// The zone the objective HUD marks for both sides.
global var marked: zone? = none
// The zone the bots were last sent at (`bot_goal_attack`, `bot_goal_defend`).
global var aimed: zone? = none

// Each side's line for the phase on, and the phase's clock.
fn brief() {
    if phase < needed {
        objective(attackers, "Take a site")
        objective(defenders, "Hold the sites")
    } else {
        objective(attackers, "Take the flag stand")
        objective(defenders, "Defend the flag stand")
    }
    countdown(attackers, phase_time)
    countdown(defenders, phase_time)
}

// A layout's spawns: the starts of the phase's number, for each side.
fn line_up() {
    spawn_areas(attackers, siege_attack, phase)
    spawn_areas(defenders, siege_defend, phase)
}

// The rows of its side the tier opens to a player.
fn offer_to(p: player) {
    let rows = tier_rows[tier]
    if p.team == attackers {
        offer(p, 0, rows.attack)
    } else {
        offer(p, 1, rows.defend)
    }
}

fn begin(n: int) {
    phase = n
    tier = 0
    if ordered { tier = min(phase, 2) }
    for each players p { offer_to(p) }
    clock = phase_time
    seen = -1
    overtime = false
    brief()
}

// The map opens with the phases: a barrier stands open from the phase it
// is numbered for. Called once a tick at most, outside the sites' loop, so
// the worst tick pays for its few barriers once.
fn open_map() {
    for each barrier b { set_open(b, b.number <= phase) }
}

// A team's index, the value the front row's colour is read from.
fn team_index(t: team) -> int = min(count(teams u where u == t and u == team 1), 1)

// The HUD each tick: the mark and the state row follow the site the
// attackers are on, else the first site still to take, then the final
// stand; the banner shows for two ticks and the kit times it from there;
// the last 30 and 10 seconds of a phase are said once each.
fn show_front() {
    if banner_left > 0 {
        banner_left = banner_left - 1
        if banner_left == 0 { hud_show(banner_row, false) }
    }
    let left = whole_seconds(clock)
    if left != seen {
        seen = left
        hud_value(phase_row, left)
        hud_show(phase_row, true)
        // The warnings are for a phase's own last seconds, not its overtime.
        if not overtime {
            if left == 30 {
                hud_text(banner_row, "30 SECONDS")
                hud_show(banner_row, true)
                banner_left = 2
            } else if left == 10 {
                hud_text(banner_row, "10 SECONDS")
                hud_show(banner_row, true)
                banner_left = 2
            }
        }
    }
    // A site someone is on stays the front, contested or not.
    if phase < needed {
        if let z = focus {
            if z.taken or count(players p where p.alive and inside(p, z)) == 0 {
                focus = none
            }
        }
        if focus == none {
            // Capture time accumulates even after attackers leave a site.
            // The mark follows living attackers, including on a contested site.
            focus = first(site s where not s.taken and (not ordered or s.number == phase) and
                count(players p where p.alive and p.team == attackers and inside(p, s)) > 0)
            if focus == none { focus = first(site s where not s.taken and (not ordered or s.number == phase)) }
        }
    } else {
        focus = last_stand
    }
    // The bots go for the front too (`bot_goal_*`, docs/game/bots.md, "A
    // script's goals"): the attackers' bots take it and the defenders'
    // bots hold it, set again only when the front moves.
    if focus != aimed {
        aimed = focus
        bot_goal_clear(attackers)
        bot_goal_clear(defenders)
        if let z = focus {
            bot_goal_attack(attackers, z)
            bot_goal_defend(defenders, z)
        }
    }
    if let o = marked {
        objective_mark(attackers, o, 0)
        objective_mark(defenders, o, 0)
        marked = none
    }
    if let z = focus {
        mark(front_mark, z)
        marked = z
        objective_mark(attackers, z, 1)
        objective_mark(defenders, z, 2)
        let here = count(players p where p.alive and p.team == attackers and inside(p, z))
        pushers = here
        // The capture gauge shows while an attacker is on the front.
        if here > 0 {
            meter(attackers, ticks(ticks_held(z, attackers)), ticks(capture_time))
            meter(defenders, ticks(ticks_held(z, attackers)), ticks(capture_time))
        } else {
            meter(attackers, 0, 0)
            meter(defenders, 0, 0)
        }
        let rival = count(players q where q.alive and q.team == defenders and inside(q, z))
        if here > 0 and rival > 0 {
            hud_style(front_row, 2)
        } else if here > 0 {
            hud_style(front_row, 1)
            hud_value(front_row, team_index(attackers))
        } else if rival > 0 {
            hud_style(front_row, 1)
            hud_value(front_row, team_index(defenders))
        } else {
            hud_style(front_row, 0)
        }
        hud_show(front_row, true)
    } else {
        pushers = 0
        meter(attackers, 0, 0)
        meter(defenders, 0, 0)
        unmark(front_mark)
        hud_show(front_row, false)
    }
}

// The round's end: the winners score a point each and the round counts
// for their team. The next round starts with the sides swapped; after the
// last, the team that won the more rounds wins the game.
fn win(side: team) {
    over = true
    clock = 0t
    countdown(attackers, 0t)
    countdown(defenders, 0t)
    meter(attackers, 0, 0)
    meter(defenders, 0, 0)
    hud_show(phase_row, false)
    for each players p where p.team == side { score(p, 1) }
    side.wins = side.wins + 1
    round = round + 1
    if round < round_count {
        next_round(side)
    } else if round_count == 1 {
        end_round(side)
    } else {
        let a = team 0
        let b = team 1
        if a.wins > b.wins {
            end_round(a)
        } else if b.wins > a.wins {
            end_round(b)
        } else {
            end_round(none)
        }
    }
}

// The round's number on the banner, the last one as the final round.
fn round_banner() {
    if round + 1 == round_count {
        hud_text(banner_row, "FINAL ROUND")
    } else if round == 0 {
        hud_text(banner_row, "ROUND 1")
    } else if round == 1 {
        hud_text(banner_row, "ROUND 2")
    } else if round == 2 {
        hud_text(banner_row, "ROUND 3")
    } else if round == 3 {
        hud_text(banner_row, "ROUND 4")
    } else if round == 4 {
        hud_text(banner_row, "ROUND 5")
    } else if round == 5 {
        hud_text(banner_row, "ROUND 6")
    } else {
        hud_text(banner_row, "ROUND 7")
    }
    hud_show(banner_row, true)
    banner_left = 2
}

// The defenders' line: a site still to take while sites remain, then
// their flag stand. A map with neither leaves them the engine's spawns.
fn fall_back() {
    if phase < needed {
        spawn_near(defenders, first(site where not taken), line)
    } else {
        spawn_near(defenders, last_stand, line)
    }
    // A line the author placed for the defenders in this phase wins.
    if let m = first(placed_line q where q.team == team 1 and q.number == phase) {
        spawn_near(defenders, m, line)
    }
}

// A death starts the side's wave when none is running. The variant's one
// life, which the death took, holds the respawn until the wave releases
// it; `respawn` gives the life back and the engine does the spawning.
fn hold(p: player) {
    if p.team == team 0 and wave0 == 0t { wave0 = wave_time }
    if p.team == team 1 and wave1 == 0t { wave1 = wave_time }
    // The dead are told when their side's wave lands: the seconds left of
    // the wave already running, or the whole of the one this death began.
    if p.team == team 0 {
        let secs = whole_seconds(wave0)
        if secs > 0 { message(p, "Reinforcements in {secs} seconds") }
    } else {
        let secs = whole_seconds(wave1)
        if secs > 0 { message(p, "Reinforcements in {secs} seconds") }
    }
}

// The side's dead come back together.
fn release(side: team) {
    if not over {
        for each players p where p.team == side and not p.alive { respawn(p) }
    }
}

on round_start {
    // Team 0 attacks in the odd rounds, team 1 in the even ones.
    if round % 2 == 0 {
        attackers = team 0
        defenders = team 1
    } else {
        attackers = team 1
        defenders = team 0
    }
    over = false
    tier = 0
    focus = none
    front = none
    advanced = false
    marked = none
    aimed = none
    wave0 = 0t
    wave1 = 0t
    // A side's rows are its own: each kit is set again from the side's table.
    for each players p { p.kit = -1 }
    offer_pick(0, "ATTACKER LOADOUT")
    pick_row(0, "BATTLE RIFLE + MAGNUM")
    pick_row(0, "SHOTGUN + MAGNUM")
    pick_row(0, "BEAM RIFLE + PLASMA PISTOL")
    pick_row(0, "SNIPER RIFLE + SMG")
    pick_row(0, "ENERGY SWORD + CARBINE")
    offer_pick(1, "DEFENDER LOADOUT")
    pick_row(1, "CARBINE + PLASMA RIFLE")
    pick_row(1, "BRUTE PLASMA + NEEDLER")
    pick_row(1, "SNIPER RIFLE + MAGNUM")
    pick_row(1, "BEAM RIFLE + PLASMA PISTOL")
    pick_row(1, "ROCKETS + BATTLE RIFLE")
    pushers = 0
    banner_left = 0
    hud_show(banner_row, false)
    hud_show(phase_row, false)
    if round_count > 1 {
        round_banner()
        let n = round + 1
        let total = round_count
        message(attackers, "Round {n} of {total}: you attack")
        message(defenders, "Round {n} of {total}: you defend")
    }
    // Spartans attack, Elites defend.
    set_body(attackers, "objects/characters/masterchief/masterchief_mp")
    set_body(defenders, "objects/characters/elite/elite_mp")
    lights = 0
    ordered = false
    top = 0
    for each site s {
        s.taken = false
        s.lit = false
        if s.number > 0 { ordered = true }
        if s.number + 1 > top { top = s.number + 1 }
        // A site shows in its holder's colour: the defenders', until it is taken.
        if lights < 6 {
            s.lit = true
            lights = lights + 1
            show_area(s, defenders)
        }
    }
    needed = min(sites, count(site))
    if ordered { needed = min(sites, top) }
    last_stand = base[defenders]
    if let g = goal { last_stand = g }
    assault = last_stand != none
    if let g = last_stand { show_area(g, defenders) }
    if needed > 0 or assault {
        begin(0)
        open_map()
        if ordered {
            line_up()
        } else {
            // The attackers start at their own flag stand, when the map has one.
            spawn_near(attackers, base[attackers], line)
            if let m = first(placed_line q where q.team == team 0 and q.number == 0) {
                spawn_near(attackers, m, line)
            }
            fall_back()
        }
        if assault {
            message(all, "Sites to take: {needed}. Then the defenders' flag")
        } else {
            message(all, "Sites to take: {needed}")
        }
    } else {
        over = true
        message(all, "This map has nothing to take: Siege needs territories or a flag stand")
        end_round(none)
    }
}

on tick {
    for each players p where p.alive and p.kit != choice(p) { equip(p, choice(p)) }
    if not over and phase < needed {
        for each site s where not s.taken {
            // A layout's site counts in its own phase only: a later
            // phase's site is not asked about, so its time starts then.
            if not ordered or s.number == phase {
                if phase < needed and ticks_held(s, attackers) >= capture_time {
                    s.taken = true
                    if s.lit { show_area(s, attackers) }
                    phase = phase + 1
                    advanced = true
                    front = s
                }
            }
        }
        // The new phase opens once, after the sites are counted.
        if advanced {
            advanced = false
            begin(phase)
        }
        // The front moves up once a tick, after the sites are counted:
        // the attackers spawn at the site they took, and the defenders
        // fall back.
        if let s = front {
            front = none
            open_map()
            if ordered {
                line_up()
            } else {
                spawn_near(attackers, s, line)
                if let m = first(placed_line q where q.team == team 0 and q.number == phase) {
                    spawn_near(attackers, m, line)
                }
                fall_back()
            }
            if phase < needed {
                message(all, "The attackers took a site")
                hud_text(banner_row, "SITE TAKEN")
                hud_show(banner_row, true)
                banner_left = 2
            } else if assault {
                message(all, "Final assault: the defenders' flag")
                hud_text(banner_row, "FINAL ASSAULT")
                hud_show(banner_row, true)
                banner_left = 2
            } else {
                message(all, "The attackers took every site")
                win(attackers)
            }
        }
    } else if not over and assault {
        if let g = last_stand and ticks_held(g, attackers) >= capture_time {
            message(all, "The attackers took the flag")
            win(attackers)
        }
    }
    // An overtime ends when the attackers are off the objective.
    if not over and overtime and pushers == 0 {
        message(all, "The defenders held")
        win(defenders)
    }
    if not over { show_front() }
}

// A phase's clock running out ends it for the defenders, unless an
// attacker is on its objective: then it runs on for the overtime, once.
on timer(clock) {
    if not over {
        if not overtime and pushers > 0 {
            overtime = true
            clock = overtime_time
            countdown(attackers, overtime_time)
            countdown(defenders, overtime_time)
            seen = -1
            message(all, "Overtime: the attackers are still on the objective")
            hud_text(banner_row, "OVERTIME")
            hud_show(banner_row, true)
            banner_left = 2
        } else {
            message(all, "The defenders held")
            win(defenders)
        }
    }
}

on kill(victim) {
    hold(victim)
}

on death(p) {
    hold(p)
}

on timer(wave0) {
    release(team 0)
}

on timer(wave1) {
    release(team 1)
}

// The player's side's kit for a row, set now.
fn equip(p: player, row: int) {
    p.kit = row
    if p.team == attackers {
        let kit = attack_rows[row]
        set_loadout(p, kit.primary, kit.secondary)
    } else {
        let kit = defend_rows[row]
        set_loadout(p, kit.primary, kit.secondary)
    }
}

// A spawn gives the row the player last picked, and the host opens the
// side's loadout dialog over the new body; a row picked there is
// equipped by the tick that hears it.
on spawn(p) {
    offer_to(p)
    equip(p, choice(p))
}
