// Siege: the phased attack-and-defend mode, with the mechanics of Halo:
// Reach's Invasion and none of its assets or text. Team 0 attacks, team 1
// defends. The map's own flags are the objectives, so a map needs no kit:
// the attackers take `sites` of its territories (any of them, each held
// alone for the capture time in all), then hold the defenders' CTF flag
// stand for the capture time to win. A map with no flag stand stops at
// the sites: taking them all wins it. Each phase has its own clock; the
// defenders win when one runs out. Each side spawns with its own loadout,
// and its dead come back together in waves: the variant's one life holds
// a death's respawn, and the side's wave timer releases it. Each side
// spawns near its line, which moves with the phases (`spawn_near`): the
// attackers at their own flag stand, then at the last site they took; the
// defenders at a site still to take, then at their flag stand. The
// attackers spawn as Spartans and the defenders as Elites (`set_body`).
// The winners score a point each, so the post-game's scores name them.
// The HUD is the King of the Hill kit's: a mark over the site the attackers
// are on (else the first still to take, then the final stand), its state
// (open, held by a side, contested), the seconds the phase has left
// (`koth.phase`), and a banner for a site taken, the final assault, an
// overtime and the last 30 and 10 seconds of a phase.
// A phase whose clock runs out with an attacker on its objective goes into
// overtime: the defenders win when the attackers leave it, or when the
// overtime runs out, whichever is first, and a capture that completes
// first takes the site as it would have.
// The map opens with the phases: each `siege_barrier` object, numbered by
// the phase it opens in, stands open from that phase on (`set_open`).
// Each player picks a loadout set before the round (`offer_pick`): the
// host opens a picker of three rows at the round's start, and the pick
// (`picked`) is the set from that player's next spawn; a player who does
// not pick gets the set the lobby chose.
// docs/game/rules-engine.md, "Phases: attack and defend" and "Payoff".
//
// Entries a host cannot make yet (`verify::unhostable`): none.
rules "Siege" 1
type siege
teams 2
requires player.weapons, player.spawn, player.disguise, player.pick, hud.message, hud.widgets, hud.waypoints, objects.move
about "Attackers take the map's territories, then storm the defenders' flag stand. Each phase has its own clock: run it out and the defenders win."
quick respawn_time, wave_time, phase_time, capture_time, sites

// Players spawn unarmed and `on spawn` gives each side its loadout, so
// the spawn's own weapons are never made and dropped. One life a round
// holds each death's respawn back, so a side's dead wait for its wave.
settings {
    team_play = true
    score_limit = none
    time_limit = none
    lives = 1
    starting_weapon = none
    secondary_weapon = none
}

// What the map supplies, when it has it. The author's places come first
// (docs/game/game-types-without-carriers.md, "Maps for scripted games"):
// `siege_site` flags are the sites (the map's territory flags when none
// is placed, `rules::labels::reads`), a `siege_goal` is the final stand
// (each team's CTF flag stand when none is placed), and `siege_line`
// flags, numbered by phase and given a team, are where a side spawns in
// that phase (the phase's own site or stand when none is placed), and
// `siege_barrier` objects, numbered by the phase they open in (a barrier
// numbered 0 is open from the start). The script requires no label of its
// own, but the lobby's start gate (`rules::gate`) refuses a map with no
// site and no final stand: with no site the assault goes straight to the
// stand, with no stand the sites are the whole assault, and a run the gate
// does not guard (a scenario) with neither draws the round at its start. A line or barrier label is bounded, so the lookups
// of a tick stay small.
label site: zones = "siege_site"
label goal: zone? = "siege_goal"
label base: zones = "ctf_flag_spawn"
label placed_line: zones at most 16 = "siege_line"
label barrier: objects at most 8 = "siege_barrier"

option phase_time: time 60s..600s = 180s "Phase time" "How long the attackers have for each phase"
option capture_time: time 5s..60s = 15s "Capture time" "How long the attackers hold a site or the flag stand alone to take it"
option sites: int 1..4 = 2 "Sites" "How many territories the attackers take before the final assault"
option wave_time: time 3s..30s = 10s "Respawn wave" "How long a side's dead wait to come back together"
option overtime_time: time 5s..60s = 30s "Overtime" "The most a phase runs on past its clock while an attacker is on its objective"

// What each side spawns with: the lobby picks one set for the game, and a
// player's own pick before the round (the picker's rows are in this order)
// takes its place.
enum Kits { standard, close, ranged }

option kits: Kits = Kits.standard "Loadouts" "The weapons each side spawns with: the standard set, close quarters or long range"

// The HUD (docs/game/game-types-without-carriers.md, "The display"): the
// front's state, a banner, and a mark over the front.
hud front_row: text at koth.hill
hud banner_row: banner at koth.banner
hud phase_row: text at koth.phase
waypoint front_mark at koth.mark

// How many starting locations a side's spawns keep near its line.
const line = 4

table loadouts: (side: team, primary: weapon, secondary: weapon) = [
    (team 0, "objects/weapons/rifle/battle_rifle/battle_rifle", "objects/weapons/pistol/magnum/magnum"),
    (team 1, "objects/weapons/rifle/covenant_carbine/covenant_carbine", "objects/weapons/rifle/plasma_rifle/plasma_rifle"),
]

table close_loadouts: (side: team, primary: weapon, secondary: weapon) = [
    (team 0, "objects/weapons/rifle/shotgun/shotgun", "objects/weapons/pistol/magnum/magnum"),
    (team 1, "objects/weapons/rifle/brute_plasma_rifle/brute_plasma_rifle", "objects/weapons/pistol/needler/needler"),
]

table ranged_loadouts: (side: team, primary: weapon, secondary: weapon) = [
    (team 0, "objects/weapons/rifle/sniper_rifle/sniper_rifle", "objects/weapons/rifle/smg/smg"),
    (team 1, "objects/weapons/rifle/beam_rifle/beam_rifle", "objects/weapons/pistol/plasma_pistol/plasma_pistol"),
]

// The phases taken so far, and how many sites come before the final one.
global var phase: int = 0
global var needed: int = 0
global var clock: timer
global var over: bool = false
// Whether the phase is past its clock with an attacker still on its
// objective, and how many attackers were on the front last tick.
global var overtime: bool = false
global var pushers: int = 0
// The defenders' final stand: the placed goal, else their flag stand.
global var last_stand: zone? = none
// Whether the map gives the attackers a flag stand to storm.
global var assault: bool = false
// Each side's respawn wave, running while that side has dead to bring
// back.
global var wave0: timer
global var wave1: timer
object var taken: bool = false
// Whether the site shows its boundary: at most six do, so the sites and
// the final stand fit the eight areas a script may show.
object var lit: bool = false
global var lights: int = 0
// The site taken this tick, if any, whose line the spawns move to.
global var front: zone? = none
// The zone the HUD follows, the banner's ticks left, and the last whole
// second of the clock a warning was weighed at.
global var focus: zone? = none
global var banner_left: int = 0
global var seen: int = -1

fn begin(n: int) {
    phase = n
    clock = phase_time
    seen = -1
    overtime = false
}

// The map opens with the phases: a barrier stands open from the phase it
// is numbered for. Called once a tick at most, outside the sites' loop, so
// the worst tick pays for its few barriers once.
fn open_map() {
    for each barrier b { set_open(b, b.number <= phase) }
}

// The HUD each tick: the mark and the state row follow the site the
// attackers are on, else the first site still to take, then the final
// stand; the banner shows for two ticks and the kit times it from there;
// the last 30 and 10 seconds of a phase are said once each.
fn show_front() {
    if banner_left > 0 {
        banner_left = banner_left - 1
        if banner_left == 0 { hud_show(banner_row, false) }
    }
    let left = whole_seconds(clock)
    if left != seen {
        seen = left
        hud_value(phase_row, left)
        hud_show(phase_row, true)
        // The warnings are for a phase's own last seconds, not its overtime.
        if not overtime {
            if left == 30 {
                hud_text(banner_row, "30 SECONDS")
                hud_show(banner_row, true)
                banner_left = 2
            } else if left == 10 {
                hud_text(banner_row, "10 SECONDS")
                hud_show(banner_row, true)
                banner_left = 2
            }
        }
    }
    // A site someone is on stays the front, contested or not.
    if phase < needed {
        if let z = focus {
            if z.taken or count(players p where p.alive and inside(p, z)) == 0 {
                focus = none
            }
        }
        if focus == none {
            // Capture time accumulates even after attackers leave a site.
            // The mark follows living attackers, including on a contested site.
            focus = first(site s where not s.taken and
                count(players p where p.alive and p.team == team 0 and inside(p, s)) > 0)
            if focus == none { focus = first(site s where not s.taken) }
        }
    } else {
        focus = last_stand
    }
    if let z = focus {
        mark(front_mark, z)
        let here = count(players p where p.alive and p.team == team 0 and inside(p, z))
        pushers = here
        let rival = count(players q where q.alive and q.team == team 1 and inside(q, z))
        if here > 0 and rival > 0 {
            hud_style(front_row, 2)
        } else if here > 0 {
            hud_style(front_row, 1)
            hud_value(front_row, 0)
        } else if rival > 0 {
            hud_style(front_row, 1)
            hud_value(front_row, 1)
        } else {
            hud_style(front_row, 0)
        }
        hud_show(front_row, true)
    } else {
        pushers = 0
        unmark(front_mark)
        hud_show(front_row, false)
    }
}

// The round's end: the winners score a point each.
fn win(side: team) {
    over = true
    clock = 0t
    hud_show(phase_row, false)
    for each players p where p.team == side { score(p, 1) }
    end_round(side)
}

// The defenders' line: a site still to take while sites remain, then
// their flag stand. A map with neither leaves them the engine's spawns.
fn fall_back() {
    if phase < needed {
        spawn_near(team 1, first(site where not taken), line)
    } else {
        spawn_near(team 1, last_stand, line)
    }
    // A line the author placed for the defenders in this phase wins.
    if let m = first(placed_line q where q.team == team 1 and q.number == phase) {
        spawn_near(team 1, m, line)
    }
}

// A death starts the side's wave when none is running. The variant's one
// life, which the death took, holds the respawn until the wave releases
// it; `respawn` gives the life back and the engine does the spawning.
fn hold(p: player) {
    if p.team == team 0 and wave0 == 0t { wave0 = wave_time }
    if p.team == team 1 and wave1 == 0t { wave1 = wave_time }
}

// The side's dead come back together.
fn release(side: team) {
    if not over {
        for each players p where p.team == side and not p.alive { respawn(p) }
    }
}

on round_start {
    over = false
    focus = none
    offer_pick(0, "LOADOUT")
    pick_row(0, "STANDARD")
    pick_row(0, "CLOSE QUARTERS")
    pick_row(0, "LONG RANGE")
    pushers = 0
    banner_left = 0
    hud_show(banner_row, false)
    hud_show(phase_row, false)
    // Spartans attack, Elites defend.
    set_body(team 0, "objects/characters/masterchief/masterchief_mp")
    set_body(team 1, "objects/characters/elite/elite_mp")
    lights = 0
    for each site s {
        s.taken = false
        s.lit = false
        // A site shows in its holder's colour: the defenders', until it is taken.
        if lights < 6 {
            s.lit = true
            lights = lights + 1
            show_area(s, team 1)
        }
    }
    needed = min(sites, count(site))
    last_stand = base[team 1]
    if let g = goal { last_stand = g }
    assault = last_stand != none
    if let g = last_stand { show_area(g, team 1) }
    if needed > 0 or assault {
        begin(0)
        open_map()
        // The attackers start at their own flag stand, when the map has one.
        spawn_near(team 0, base[team 0], line)
        if let m = first(placed_line q where q.team == team 0 and q.number == 0) {
            spawn_near(team 0, m, line)
        }
        fall_back()
        if assault {
            message(all, "Sites to take: {needed}. Then the defenders' flag")
        } else {
            message(all, "Sites to take: {needed}")
        }
    } else {
        over = true
        message(all, "This map has nothing to take: Siege needs territories or a flag stand")
        end_round(none)
    }
}

on tick {
    if not over and phase < needed {
        for each site s where not s.taken {
            if phase < needed and ticks_held(s, team 0) >= capture_time {
                s.taken = true
                if s.lit { show_area(s, team 0) }
                begin(phase + 1)
                front = s
            }
        }
        // The front moves up once a tick, after the sites are counted:
        // the attackers spawn at the site they took, and the defenders
        // fall back.
        if let s = front {
            front = none
            open_map()
            spawn_near(team 0, s, line)
            if let m = first(placed_line q where q.team == team 0 and q.number == phase) {
                spawn_near(team 0, m, line)
            }
            fall_back()
            if phase < needed {
                message(all, "The attackers took a site")
                hud_text(banner_row, "SITE TAKEN")
                hud_show(banner_row, true)
                banner_left = 2
            } else if assault {
                message(all, "Final assault: the defenders' flag")
                hud_text(banner_row, "FINAL ASSAULT")
                hud_show(banner_row, true)
                banner_left = 2
            } else {
                message(all, "The attackers took every site")
                win(team 0)
            }
        }
    } else if not over and assault {
        if let g = last_stand and ticks_held(g, team 0) >= capture_time {
            message(all, "The attackers took the flag")
            win(team 0)
        }
    }
    // An overtime ends when the attackers are off the objective.
    if not over and overtime and pushers == 0 {
        message(all, "The defenders held")
        win(team 1)
    }
    if not over { show_front() }
}

// A phase's clock running out ends it for the defenders, unless an
// attacker is on its objective: then it runs on for the overtime, once.
on timer(clock) {
    if not over {
        if not overtime and pushers > 0 {
            overtime = true
            clock = overtime_time
            seen = -1
            message(all, "Overtime: the attackers are still on the objective")
            hud_text(banner_row, "OVERTIME")
            hud_show(banner_row, true)
            banner_left = 2
        } else {
            message(all, "The defenders held")
            win(team 1)
        }
    }
}

on kill(victim) {
    hold(victim)
}

on death(p) {
    hold(p)
}

on timer(wave0) {
    release(team 0)
}

on timer(wave1) {
    release(team 1)
}

on spawn(p) {
    // The player's row of the picker, or -1 when none was made.
    let own = picked(p, 0)
    if own == 1 or (own < 0 and kits == Kits.close) {
        let kit = close_loadouts[p.team]
        set_loadout(p, kit.primary, kit.secondary)
    } else if own == 2 or (own < 0 and kits == Kits.ranged) {
        let kit = ranged_loadouts[p.team]
        set_loadout(p, kit.primary, kit.secondary)
    } else {
        let kit = loadouts[p.team]
        set_loadout(p, kit.primary, kit.secondary)
    }
}
