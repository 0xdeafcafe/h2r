rules "Firefight" 1
type firefight
requires ai.squads, firefight.director
use "firefight-waves.rules"

label ff_drop: objects at most 12
// The Firefight host supplies one record per squad slot, in slot order.
// Each record also names the roster slot of the same index for life bonuses.
label ff_slots: objects exactly 16

option difficulty: int 0..3 = 1 "Difficulty"
option skull_assassins: bool = false
option skull_thunderstorm: bool = false
option skull_famine: bool = false
option skull_black_eye: bool = false
option skull_ghost: bool = false
option skull_catch: bool = false
option skull_mythic: bool = false
option skull_angry: bool = false
option skull_low_gravity: bool = false

const warmup = 0
const spawning = 1
const fighting = 2
const cleanup = 3
const intermission = 4
const done = 5
const bonus_round = 6

const free = 0
const placed = 1
const reported = 2
const draining = 3
// Cleanup erases stragglers after a minute. A slot can be reclaimed
// after three seconds if placement or erasure goes unobserved.
const cleanup_actors = 3
const cleanup_timeout = 60s
const slot_timeout = 3s

global var started: bool = false
global var phase: int = warmup
global var phase_tick: int = 0
global var set_index: int = 0
global var round: int = 0
global var wave: int = 0
global var next_squad: int = 0
global var wave_actors: int = 0
global var pool_0: int = start_pool
global var pool_1: int = second_pool
global var score_0: int = 0
global var score_1: int = 0
global var skulls: int = 0
// The skulls the match began with: a new set leaves them on.
global var base_skulls: int = 0
// The bonus round: the skulls it switched on (a bit mask, so the set's own
// are kept), each side's score when it began, the shift that points
// `wave_index()` at the bonus squad's row, and Iron.
global var bonus_added: int = 0
global var bonus_base_0: int = 0
global var bonus_base_1: int = 0
global var bonus_shift: int = 0
global var iron: bool = false
global var extra: int = 0

player var registered: bool = false
player var remaining_lives: int = start_pool
player var respawning: bool = false
player var side: int = 0

object var slot_index: int = 0
object var squad_state: int = free
object var squad_count: int = 0
object var squad_remaining: int = 0
object var squad_tick: int = 0
object var squad_side: int = 0

object var zone_index: int = 0
object var zone_rank_distance: int = 0
object var zone_candidate: bool = false

// Scratch results used within a handler.
global var cursor: int = 0
global var live_count: int = 0
global var load_0: int = 0
global var load_1: int = 0
global var chosen_slot: object? = none
global var chosen_zone: int = -1
global var candidate_count: int = 0
global var near_count: int = 0
global var winner: team? = none
global var lives_0: int = 0
global var lives_1: int = 0
global var carry: int = 0
global var skull_factor: int = 1000
global var target_team: team = team 0
global var other_team: team = team 1
global var limb_0: int = 0
global var limb_1: int = 0
global var limb_2: int = 0
global var limb_3: int = 0
global var limb_4: int = 0
global var limb_5: int = 0
global var limb_6: int = 0
global var limb_7: int = 0
global var limb_8: int = 0
global var limb_9: int = 0
global var limb_10: int = 0
global var limb_11: int = 0
global var limb_12: int = 0

fn wave_index() -> int = round * waves_per_round + wave + bonus_shift
fn active(s: object) -> bool = s.squad_state == placed or s.squad_state == reported

fn show_pool(side: int, pool: int) {
    if team_count == 1 { ff_lives(none, pool) }
    else if side == 0 { ff_team_lives(team 0, pool) }
    else { ff_team_lives(team 1, pool) }
}

on init {
    started = true
    phase_tick = ticks(now()) + waves[0].gap
    cursor = 0
    for each ff_slots s {
        s.slot_index = cursor
        cursor = cursor + 1
    }
    if shared_lives == 1 {
        show_pool(0, pool_0)
        if team_count == 2 { show_pool(1, pool_1) }
    }
    if skull_assassins { skulls = skulls + 1 }
    if skull_thunderstorm { skulls = skulls + 2 }
    if skull_famine { skulls = skulls + 4 }
    if skull_black_eye { skulls = skulls + 8 }
    if skull_ghost { skulls = skulls + 16 }
    if skull_catch { skulls = skulls + 32 }
    if skull_mythic { skulls = skulls + 64 }
    if skull_angry { skulls = skulls + 128 }
    if skull_low_gravity { skulls = skulls + 256 }
    base_skulls = skulls
}

on join(p) {
    if phase != done and not p.registered {
        p.registered = true
        if team_count == 2 and p.team != team 0 { p.side = 1 }
        if shared_lives == 0 {
            p.remaining_lives = start_pool
            ff_lives(p, start_pool)
        }
    }
}

fn credit(p: player, points: int) {
    if p.side == 0 { score_0 = score_0 + points }
    else { score_1 = score_1 + points }
}

// Thousandths, multiplied exactly in base-1000 limbs. Divide only after
// the difficulty and all nine skull factors have been applied.
fn multiply(factor: int) {
    carry = 0
    let product_0 = limb_0 * factor + carry
    limb_0 = product_0 % 1000
    carry = product_0 / 1000
    let product_1 = limb_1 * factor + carry
    limb_1 = product_1 % 1000
    carry = product_1 / 1000
    let product_2 = limb_2 * factor + carry
    limb_2 = product_2 % 1000
    carry = product_2 / 1000
    let product_3 = limb_3 * factor + carry
    limb_3 = product_3 % 1000
    carry = product_3 / 1000
    let product_4 = limb_4 * factor + carry
    limb_4 = product_4 % 1000
    carry = product_4 / 1000
    let product_5 = limb_5 * factor + carry
    limb_5 = product_5 % 1000
    carry = product_5 / 1000
    let product_6 = limb_6 * factor + carry
    limb_6 = product_6 % 1000
    carry = product_6 / 1000
    let product_7 = limb_7 * factor + carry
    limb_7 = product_7 % 1000
    carry = product_7 / 1000
    let product_8 = limb_8 * factor + carry
    limb_8 = product_8 % 1000
    carry = product_8 / 1000
    let product_9 = limb_9 * factor + carry
    limb_9 = product_9 % 1000
    carry = product_9 / 1000
    let product_10 = limb_10 * factor + carry
    limb_10 = product_10 % 1000
    carry = product_10 / 1000
    let product_11 = limb_11 * factor + carry
    limb_11 = product_11 % 1000
    carry = product_11 / 1000
    let product_12 = limb_12 * factor + carry
    limb_12 = product_12 % 1000
}

fn multiply_skull(index: int) {
    let skull = skull_data[index]
    skull_factor = 1000
    if skulls / skull.bit % 2 == 1 { skull_factor = skull.multiplier }
    multiply(skull_factor)
}

fn weigh_kill(base: int) {
    limb_0 = base % 1000
    limb_1 = base / 1000
    limb_2 = 0
    limb_3 = 0
    limb_4 = 0
    limb_5 = 0
    limb_6 = 0
    limb_7 = 0
    limb_8 = 0
    limb_9 = 0
    limb_10 = 0
    limb_11 = 0
    limb_12 = 0
    multiply(difficulties[difficulty].multiplier)
    multiply_skull(0)
    multiply_skull(1)
    multiply_skull(2)
    multiply_skull(3)
    multiply_skull(4)
    multiply_skull(5)
    multiply_skull(6)
    multiply_skull(7)
    multiply_skull(8)
}

fn weighed_points() -> int = limb_12 * 1000000 + limb_11 * 1000 + limb_10

on actor_kill(killer, kind) {
    if phase != done {
        if let p = killer {
            let base = class_points[kind].value
            if base > 0 {
                weigh_kill(base)
                let points = weighed_points()
                ff_score(p, points, false)
                credit(p, points)
            }
        }
    }
}

on actor_assist(killer, assist, kind) {
    if phase != done and killer != none {
        if let p = assist and p != killer {
            let base = class_points[kind].value
            if base > 0 {
                weigh_kill(base)
                let points = weighed_points() * assist_share / 1000
                if points > 0 {
                    ff_score(p, points, true)
                    credit(p, points)
                }
            }
        }
    }
}

on kill(victim, killer) {
    if phase != done and team_count == 2 and player_kill_points > 0 {
        if let p = killer and p.side != victim.side {
            ff_player_score(p, player_kill_points)
            credit(p, player_kill_points)
        }
    }
}

fn observe_squads(tick: int) {
    live_count = 0
    load_0 = 0
    load_1 = 0
    chosen_slot = none
    for each ff_slots s {
        let observed = squad_alive(squad(s.slot_index))
        if active(s) {
            let remaining = min(observed, s.squad_remaining)
            if s.squad_state == reported or remaining > 0 {
                s.squad_state = reported
                s.squad_remaining = remaining
            } else if tick >= s.squad_tick + ticks(slot_timeout) {
                s.squad_remaining = 0
            }
            if s.squad_remaining == 0 { s.squad_state = free }
        } else if s.squad_state == draining and (observed == 0 or tick >= s.squad_tick + ticks(slot_timeout)) {
            s.squad_state = free
        }
        if s.squad_state == free and chosen_slot == none { chosen_slot = s }
        live_count = live_count + s.squad_remaining
        if s.squad_side == 0 { load_0 = load_0 + s.squad_remaining }
        else { load_1 = load_1 + s.squad_remaining }
    }
}

fn bring_back(p: player) {
    p.respawning = true
    ff_respawn(p)
}

fn respawn_players() {
    let between = zero_holds == 0 and (phase == warmup or phase == intermission)
    for each players p {
        if p.alive { p.respawning = false }
        else if not p.respawning {
            if shared_lives == 0 {
                if p.remaining_lives > 0 {
                    p.remaining_lives = p.remaining_lives - 1
                    bring_back(p)
                    ff_lives(p, p.remaining_lives)
                } else if between { bring_back(p) }
            } else if p.side == 0 {
                if pool_0 > 0 {
                    pool_0 = pool_0 - 1
                    bring_back(p)
                    show_pool(0, pool_0)
                } else if between { bring_back(p) }
            } else {
                if pool_1 > 0 {
                    pool_1 = pool_1 - 1
                    bring_back(p)
                    show_pool(1, pool_1)
                } else if between { bring_back(p) }
            }
        }
    }
}

fn decide_winner() {
    lives_0 = pool_0
    lives_1 = pool_1
    if shared_lives == 0 {
        lives_0 = 0
        lives_1 = 0
        for each ff_slots s {
            if let p = player_of(s) and p.registered {
                if p.side == 0 { lives_0 = lives_0 + p.remaining_lives }
                else { lives_1 = lives_1 + p.remaining_lives }
            }
        }
    }
    winner = none
    if score_0 > score_1 or (score_0 == score_1 and lives_0 > lives_1) { winner = team 0 }
    else if score_1 > score_0 or (score_0 == score_1 and lives_1 > lives_0) { winner = team 1 }
}

fn check_defeat(here_0: bool, here_1: bool) {
    let out_0 = here_0 and count(players p where p.side == 0 and (p.alive or p.respawning)) == 0
    let out_1 = here_1 and count(players p where p.side == 1 and (p.alive or p.respawning)) == 0
    if out_0 or out_1 {
        if here_0 and here_1 {
            if out_0 and out_1 { decide_winner() }
            else if out_0 { winner = team 1 }
            else { winner = team 0 }
            ff_team_finish(winner)
        } else { ff_finish(false) }
        phase = done
    }
}

fn round_bonus() {
    if shared_lives == 1 {
        pool_0 = pool_0 + bonus_lives
        show_pool(0, pool_0)
        if team_count == 2 {
            pool_1 = pool_1 + bonus_lives
            show_pool(1, pool_1)
        }
    } else {
        for each ff_slots s {
            if let p = player_of(s) and p.registered {
                p.remaining_lives = p.remaining_lives + bonus_lives
                ff_lives(p, p.remaining_lives)
            }
        }
    }
}

fn pause(tick: int) {
    phase = intermission
    phase_tick = tick + waves[wave_index()].gap
}

// A round is over and no bonus round follows: the next round, or the end.
fn next_round(tick: int, here_0: bool, here_1: bool) {
    if round + 1 < len(round_data) {
        round = round + 1
        wave = 0
        round_bonus()
        pause(tick)
    } else if endless == 1 {
        // The next set begins; the game ends only when the team is out.
        set_index = set_index + 1
        round = 0
        wave = 0
        round_bonus()
        pause(tick)
    } else {
        if team_count == 1 { ff_finish(true) }
        else {
            if here_0 and not here_1 { winner = team 0 }
            else if here_1 and not here_0 { winner = team 1 }
            else { decide_winner() }
            ff_team_finish(winner)
        }
        phase = done
    }
}

fn bonus_skull(index: int) {
    if index >= 0 {
        let skull = skull_data[index]
        if skulls / skull.bit % 2 == 0 {
            skulls = skulls + skull.bit
            bonus_added = bonus_added + skull.bit
            ff_skull(skull.id, true)
        }
    }
}

fn bonus_restore(index: int) {
    if index >= 0 {
        let skull = skull_data[index]
        if bonus_added / skull.bit % 2 == 1 {
            skulls = skulls - skull.bit
            ff_skull(skull.id, false)
        }
    }
}

// Every skull on for the bonus round's length, Iron with them. No life is
// spent in it and no respawn is issued: `on tick` skips both while it runs.
fn start_bonus(tick: int) {
    phase = bonus_round
    phase_tick = tick + bonus_ticks
    bonus_shift = len(waves) - 1 - (round * waves_per_round + wave)
    bonus_base_0 = score_0
    bonus_base_1 = score_1
    bonus_added = 0
    next_squad = 0
    wave_actors = 0
    ff_bonus(true, bonus_ticks)
    let listed = bonus_skulls[0]
    bonus_skull(listed.s0)
    bonus_skull(listed.s1)
    bonus_skull(listed.s2)
    bonus_skull(listed.s3)
    bonus_skull(listed.s4)
    bonus_skull(listed.s5)
    bonus_skull(listed.s6)
    bonus_skull(listed.s7)
    bonus_skull(listed.s8)
    if not iron {
        iron = true
        ff_skull(11, true)
    }
}

fn end_wave(tick: int, here_0: bool, here_1: bool) {
    for each players p where not p.alive and not p.respawning and zero_holds == 0 { bring_back(p) }
    if wave + 1 < waves_per_round {
        wave = wave + 1
        pause(tick)
    } else if bonus_on == 1 and (round + 1) % set_rounds == 0 { start_bonus(tick) }
    else { next_round(tick, here_0, here_1) }
}

// The lives of the last row of the table the points reach.
fn reach(points: int, need: int, lives_given: int) {
    if need >= 0 and points >= need { extra = lives_given }
}

fn grant_side(side: int, points: int) {
    let t = bonus_rows[0]
    extra = 0
    reach(points, t.need0, t.extra0)
    reach(points, t.need1, t.extra1)
    reach(points, t.need2, t.extra2)
    reach(points, t.need3, t.extra3)
    reach(points, t.need4, t.extra4)
    reach(points, t.need5, t.extra5)
    if extra > 0 {
        if shared_lives == 1 {
            if side == 0 {
                pool_0 = pool_0 + extra
                show_pool(0, pool_0)
            } else {
                pool_1 = pool_1 + extra
                show_pool(1, pool_1)
            }
        } else {
            for each ff_slots s {
                if let p = player_of(s) and p.registered and p.side == side {
                    p.remaining_lives = p.remaining_lives + extra
                    ff_lives(p, p.remaining_lives)
                }
            }
        }
    }
}

fn enable_skull(index: int) {
    if index >= 0 {
        let skull = skull_data[index]
        if skulls / skull.bit % 2 == 0 {
            skulls = skulls + skull.bit
            ff_skull(skull.id, true)
        }
    }
}

// A round skull the set switched on goes off at a new set, unless the
// match began with it.
fn reset_skull(index: int) {
    let skull = skull_data[index]
    if skull.scheduled == 1 and skulls / skull.bit % 2 == 1 and base_skulls / skull.bit % 2 == 0 {
        skulls = skulls - skull.bit
        ff_skull(skull.id, false)
    }
}

// Sets 2, 3 and 4 add one set skull each, and it stays.
fn begin_set() {
    ff_set(set_index)
    if set_index > 0 {
        reset_skull(0)
        reset_skull(1)
        reset_skull(2)
        reset_skull(3)
        reset_skull(4)
        reset_skull(5)
        reset_skull(6)
        reset_skull(7)
        reset_skull(8)
        if set_index - 1 < set_skull_count { enable_skull(set_skulls[set_index - 1].which) }
    }
}

fn start_wave() {
    if wave == 0 {
        if round == 0 and endless == 1 { begin_set() }
        ff_round(round)
        let scheduled = round_data[round]
        enable_skull(scheduled.s0)
        enable_skull(scheduled.s1)
        enable_skull(scheduled.s2)
        enable_skull(scheduled.s3)
        enable_skull(scheduled.s4)
        enable_skull(scheduled.s5)
        enable_skull(scheduled.s6)
        enable_skull(scheduled.s7)
        enable_skull(scheduled.s8)
    }
    ff_wave(wave)
    next_squad = 0
    wave_actors = 0
    phase = spawning
}

// Prefer a hidden authored zone. Otherwise pick from the farther half
// of hidden zones (or all zones if exposed), with ties in kit order.
// A role (a bit mask; 0 for any) keeps only the zones that carry it.
fn pick_zone(preferred: int, role: int, target: team, other: team) {
    chosen_zone = -1
    cursor = 0
    let all_exposed = count(ff_drop z where zone_has_role(z, role) and not zone_seen(z)) == 0
    candidate_count = 0
    near_count = 0
    for each ff_drop z {
        let hidden = not zone_seen(z)
        let fits = zone_has_role(z, role)
        z.zone_index = cursor
        z.zone_candidate = fits and (all_exposed or hidden)
        if hidden and fits and cursor == preferred { chosen_zone = cursor }
        if z.zone_candidate {
            candidate_count = candidate_count + 1
            if team_count == 2 {
                let distance = zone_team_distance(z, target)
                z.zone_rank_distance = distance
                if distance <= zone_team_distance(z, other) { near_count = near_count + 1 }
            } else { z.zone_rank_distance = zone_distance(z) }
        }
        cursor = cursor + 1
    }
    if chosen_zone == -1 and candidate_count > 0 {
        if near_count > 0 {
            candidate_count = near_count
            for each ff_drop z where z.zone_candidate {
                z.zone_candidate = z.zone_rank_distance <= zone_team_distance(z, other)
            }
        }
        let farther_half = (candidate_count + 1) / 2
        cursor = 0
        if farther_half > 1 { cursor = random(farther_half) }
        for each ff_drop z where z.zone_candidate {
            let range = z.zone_rank_distance
            let index = z.zone_index
            let rank = count(ff_drop w where w.zone_candidate and (w.zone_rank_distance > range or (w.zone_rank_distance == range and w.zone_index < index)))
            if rank == cursor { chosen_zone = index }
        }
    }
}

fn place_next(tick: int, players_in_match: int, cap: int, here_0: bool, here_1: bool) {
    let current = waves[wave_index()]
    if next_squad < current.count {
        if let s = chosen_slot {
            let entry = squads[current.first + next_squad]
            let base_size = clamp(players_in_match * entry.per_player, entry.minimum, entry.maximum)
            // Each set grows the squads by set_scale thousandths, up to the cap.
            let size = min(base_size * (1000 + set_scale * set_index) / 1000, cap)
            if live_count + size <= cap {
                cursor = 0
                if team_count == 2 {
                    if here_1 and not here_0 { cursor = 1 }
                    else if here_0 == here_1 {
                        if load_0 > load_1 { cursor = 1 }
                        else if load_0 == load_1 { cursor = next_squad % 2 }
                    }
                }
                // Zone selection uses cursor as scratch.
                let target_side = cursor
                if target_side == 0 {
                    target_team = team 0
                    other_team = team 1
                } else {
                    target_team = team 1
                    other_team = team 0
                }
                pick_zone(entry.preferred, entry.zone_role, target_team, other_team)
                if chosen_zone >= 0 {
                    let id = squad(s.slot_index)
                    s.squad_state = placed
                    s.squad_count = size
                    s.squad_remaining = size
                    s.squad_tick = tick
                    s.squad_side = target_side
                    place_squad_at(id, entry.kind, size, chosen_zone, entry.tier)
                    if team_count == 2 { ff_target(id, target_team) }
                    next_squad = next_squad + 1
                    wave_actors = wave_actors + size
                    live_count = live_count + size
                    if target_side == 0 { load_0 = load_0 + size }
                    else { load_1 = load_1 + size }
                    chosen_slot = first(ff_slots slot where slot.squad_state == free)
                }
            }
        }
    }
}

fn erase_all(tick: int) {
    for each ff_slots s where active(s) {
        erase_squad(squad(s.slot_index))
        s.squad_state = draining
        s.squad_tick = tick
        s.squad_remaining = 0
    }
    live_count = 0
    load_0 = 0
    load_1 = 0
    chosen_slot = first(ff_slots s where s.squad_state == free)
}

// The bonus round ends on time or when every player is dead, never the
// game: erase, switch its skulls off, grant lives by the points it scored,
// bring everyone back, and go on as a finished round does.
fn end_bonus(tick: int, here_0: bool, here_1: bool) {
    erase_all(tick)
    let listed = bonus_skulls[0]
    bonus_restore(listed.s0)
    bonus_restore(listed.s1)
    bonus_restore(listed.s2)
    bonus_restore(listed.s3)
    bonus_restore(listed.s4)
    bonus_restore(listed.s5)
    bonus_restore(listed.s6)
    bonus_restore(listed.s7)
    bonus_restore(listed.s8)
    bonus_added = 0
    if iron {
        iron = false
        ff_skull(11, false)
    }
    ff_bonus(false, 0)
    grant_side(0, score_0 - bonus_base_0)
    if team_count == 2 { grant_side(1, score_1 - bonus_base_1) }
    for each players p where not p.alive and not p.respawning { bring_back(p) }
    bonus_shift = 0
    next_round(tick, here_0, here_1)
}

on tick {
    if phase != done {
        let tick = ticks(now())
        observe_squads(tick)
        let here_0 = count(players p where p.side == 0) > 0
        let here_1 = count(players p where p.side == 1) > 0
        if phase != bonus_round {
            respawn_players()
            check_defeat(here_0, here_1)
        }

        if phase == cleanup and (live_count == 0 or tick >= phase_tick + ticks(cleanup_timeout)) {
            erase_all(tick)
            end_wave(tick, here_0, here_1)
        } else if phase == fighting and live_count == 0 {
            end_wave(tick, here_0, here_1)
        }

        if (phase == warmup or phase == intermission) and tick >= phase_tick { start_wave() }
        if phase == bonus_round {
            for each players p where p.alive { p.respawning = false }
            if tick >= phase_tick or count(players p where p.alive) == 0 { end_bonus(tick, here_0, here_1) }
        }
        if phase == spawning or phase == bonus_round {
            let size = clamp(count(players), 1, largest_roster)
            let cap = actor_caps[size - 1].actors
            let before = next_squad
            // The bonus squad is the last row of the tables: one squad
            // placed again each time there is room, until time is up.
            if phase == bonus_round { next_squad = 0 }
            place_next(tick, size, cap, here_0, here_1)
            if phase == spawning {
                if next_squad > before { place_next(tick, size, cap, here_0, here_1) }
                if next_squad == waves[wave_index()].count { phase = fighting }
            }
        }
        if phase == fighting and live_count > 0 and live_count <= cleanup_actors and live_count < wave_actors {
            for each ff_slots s where active(s) { hunt(squad(s.slot_index)) }
            phase = cleanup
            phase_tick = tick
        }
    }
}
