// Race: the map's King of the Hill hills are the checkpoints, so every map
// with hills races with no kit. A player runs them in number order, from
// the lowest, and back to the lowest for a lap; a hill a number skips is
// no checkpoint. A lap is a point, and the first to `laps` wins.
// docs/game/rules-engine.md, "Payoff".
//
// A hill is one zone, the polygon of its corners
// (`game::rules::world::zones`), so a hill's number is its checkpoint's.
//
// Entries a host cannot make yet (`verify::unhostable`): none.
// Not covered: the start is wherever a player spawns (`spawn_areas` is
// untraced); Halo 1's race track points are dropped at conversion.
rules "Race" 1
type party
points "Laps"
requires hud.message
about "Run the map's hills in order, from the lowest, and back to it for a lap. The first to finish the laps wins. Plays on every map with hills."
quick laps, time_limit, respawn_time

// The laps end the round, so no score limit gets there first.
settings {
    score_limit = none
}

// What the map supplies: its hills, by their corners (three at least make
// one hill; 64 bound the round start's work).
label checkpoint: zones numbered at least 3 at most 64 = "hill_corner"

option laps: int 1..10 = 3 "Laps" "How many laps win the race"

// No hill has this number: `after` found none.
const past = 1000

// The player's next checkpoint, once the player has crossed the first.
player var next: int = 0
player var started: bool = false
// Laps run; the score read back lands a tick late on a host.
player var lap: int = 0

global var first_hill: int = 0
global var found: int = 0
global var track: bool = false
global var over: bool = false
// Each corner's next hill round the track, worked out at the round's
// start so an entry costs no loop.
object var onward: int = 0

// The lowest hill number above n, or `past`.
fn after(n: int) {
    found = past
    for each checkpoint c {
        if c.number > n and c.number < found { found = c.number }
    }
}

on round_start {
    over = false
    after(-1)
    first_hill = found
    after(first_hill)
    track = found != past
    // The hill after each one: the next number, or the first after the last.
    for each checkpoint c {
        after(c.number)
        if found == past { c.onward = first_hill } else { c.onward = found }
    }
    for each players p {
        p.started = false
        p.next = first_hill
        p.lap = 0
    }
    if track {
        message(all, "Race: {laps} laps. Start at hill {first_hill}")
    } else {
        message(all, "This map has one hill: Race needs two")
    }
}

on enter(checkpoint z, o) {
    if track and not over {
        if let p = player_of(o) {
            if not p.started {
                // A player's lap starts at the first hill.
                if z.number == first_hill {
                    p.started = true
                    p.next = z.onward
                }
            } else if z.number == p.next {
                if z.number == first_hill {
                    p.lap = p.lap + 1
                    score(p, 1)
                    let done = p.lap
                    if done >= laps {
                        over = true
                        message(all, "{p} won the race")
                        end_round(p.team)
                    } else {
                        message(p, "Lap {done} of {laps}")
                    }
                }
                p.next = z.onward
            }
        }
    }
}
