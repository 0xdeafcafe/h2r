// Bounce Hunt: a point for each superbounce, three for the first
// bounce anyone lands on a spot, and low gravity if the variant asks.
// Bounces are observed, never made.
// docs/game/rules-engine.md, "Firefight, AI and bounces" and "Payoff".
//
// Entries a host cannot make yet (`verify::unhostable`): none. `on bounce`
// waits on the bounce detector (roadmap phase 8).
rules "Bounce Hunt" 1
type slayer
requires game.traits

option low_gravity: bool = false "Low gravity" "Half gravity, for practising the approach"
option first_points: int 1..5 = 3 "First find" "Points for the first bounce on a spot"

object var found: bool = false
player var bounces: int = 0

on init {
    if low_gravity { set_gravity(0.5) }
}

on round_start {
    for each players p { p.bounces = 0 }
}

on bounce(p, spot, chain, monster) {
    p.bounces = p.bounces + 1
    if not spot.found {
        spot.found = true
        score(p, first_points)
    } else {
        score(p, 1)
    }
}
