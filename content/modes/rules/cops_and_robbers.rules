// Cops and Robbers: blue cops with shotguns, red robbers with plasma
// pistols. The jail rules stay in `about`.
// docs/game/community-gametypes.md.
rules "Cops and Robbers" 1
type party
points "Kills"
uses slayer
about "Blue cops use only shotguns, red robbers only plasma pistols. Robbers who give up walk to jail. Three lives."
quick lives, score_limit, time_limit, starting_weapon, secondary_weapon

settings {
    team_play = true
    lives = 3
    shields = none
    overshield_pickups = false
    camo_pickups = false
    starting_weapon = shotgun
    secondary_weapon = plasma_pistol
    weapons_on_map = none
}
