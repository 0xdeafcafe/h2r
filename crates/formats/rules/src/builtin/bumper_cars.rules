// Bumper Cars: no weapons, only Warthogs and Ghosts. `starting_weapon =
// none` is one of our added choices; without `variant_options` the entry
// is left out. docs/game/game-options.md.
rules "Bumper Cars" 1
type party
points "Kills"
uses slayer
about "No weapons at all, only Warthogs and Ghosts. Splatter everyone else. Try Coagulation or Burial Mounds."
quick score_limit, time_limit, light_vehicle, second_light_vehicle, respawn_time

settings {
    starting_weapon = none
    secondary_weapon = none
    starting_grenades = false
    weapons_on_map = none
    grenades_on_map = false
    overshield_pickups = false
    camo_pickups = false
    light_vehicle = warthog
    second_light_vehicle = ghost
    heavy_vehicle = none
    flying_vehicle = none
    primary_turret = none
    secondary_turret = none
    score_limit = 25
}
