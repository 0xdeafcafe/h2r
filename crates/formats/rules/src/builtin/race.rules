// Race: labelled checkpoints ("checkpoint" 0, 1, ...) passed in order make
// a lap, and a lap is a point, so the score limit is the lap count. Players
// start at the "race_start" spawns, as Halo 1's per-spawn game types do.
// docs/game/rules-engine.md, "Payoff".
//
// Entries a host cannot make yet (`verify::unhostable`):
//   player_of        traced (unit `+0x13c`)
//   spawn_areas      untraced (the PLAYER_SPAWN_LOCATION rule)
// `on enter` waits on the zone tests (not built).
rules "Race" 1
carrier slayer
requires player.spawn

player var next: int = 0
global var checkpoints: int = 0

on round_start {
    checkpoints = count(objects labelled "checkpoint")
    for each players p { p.next = 0 }
    for each teams t { spawn_areas(t, labelled "race_start", 0) }
}

on enter(zone, o) {
    let p = player_of(o)
    if p != none and checkpoints > 0 and zone.label == labelled "checkpoint" and zone.number == p.next {
        p.next = p.next + 1
        if p.next >= checkpoints {
            p.next = 0
            score(p, 1)
        }
    }
}
