// Wheeeeee!: rockets, extra damage and a fast, tough ball carrier. The
// score to win is seconds with the ball.
// docs/game/community-gametypes.md.
rules "Wheeeeee!" 1
carrier oddball
scoring carrier
about "Rockets, extra damage and a fast, tough ball carrier. How high can you fly?"
quick score_limit, time_limit, oddball_ball_speed, starting_weapon, weapon_respawn

settings {
    team_play = true
    shields = none
    extra_damage = true
    oddball_ball_speed = fast
    oddball_ball_toughness = true
    starting_weapon = rocket_launcher
    weapons_on_map = rockets
    weapon_respawn = double_time
    score_limit = 30
}
