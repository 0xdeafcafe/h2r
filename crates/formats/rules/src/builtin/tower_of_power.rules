// Tower of Power: teams fight for the tower with shotguns.
// docs/game/community-gametypes.md.
rules "Tower of Power" 1
type slayer
uses slayer
about "Teams fight for the tower with shotguns and no shields. Made for Ascension."
quick score_limit, time_limit, starting_weapon, respawn_time, team_play

settings {
    team_play = true
    shields = none
    respawn_time = 3s
    light_vehicle = none
    primary_turret = machine_gun
    starting_weapon = shotgun
    secondary_weapon = none
    weapons_on_map = shotguns
    starting_grenades = false
    grenades_on_map = false
    overshield_pickups = false
    camo_pickups = false
    score_limit = 100
}
