// Superbounce: Slayer's rules with the superbounce mode's guide (the HUD,
// the marks over the map, priming and the medals), which the host turns
// on for `requires hud.superbounce`. `list tweakers` files its variants
// under Tweakers. Its record settings (no score or time limit, 3 s
// respawn, overshields, a magnum, nothing on the map) are the variant
// record's, not the script's. A bounce scores nothing unless the variant
// asks; the medals and chains are the host's.
// docs/game/superbounce.md, "The superbounce game type", and
// docs/game/rules-engine.md, "Firefight, AI and bounces".
//
// Entries a host cannot make yet (`verify::unhostable`): none.
rules "Superbounce" 1
carrier slayer
list tweakers
requires hud.superbounce

option kill_points: int 1..5 = 1 "Kill points" "Points for each kill"
option suicide_costs: bool = true "Suicide penalty" "A suicide costs a point"
option bounce_points: int 0..5 = 0 "Bounce points" "Points for each superbounce"

player var bounces: int = 0

on kill(victim, killer) {
    if killer == none or killer == victim {
        if suicide_costs { score(victim, -1) }
    } else if variant.team_play and killer.team == victim.team {
        score(killer, -1)
    } else {
        score(killer, kill_points)
    }
}

on bounce(p, spot) {
    p.bounces = p.bounces + 1
    if bounce_points > 0 { score(p, bounce_points) }
}
