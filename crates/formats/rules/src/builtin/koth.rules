// King of the Hill (engine index 4): hills from flag types 11 to 18 (label
// "hill_corner", numbered by hill), the hill in play, moving hills, a
// point for each second on the hill, and contesting.
// docs/game/rules-engine.md, "Porting the seven engines".
//
// Entries a host cannot make yet (`verify::unhostable`):
//   label_number     not built (Forge labels)
//   inside           not built (zone tests on the corners' polygon)
// Not reproduced: the KotH globals (`[0x51ecc8]`: the hill in play
// `+0x1a4`, the occupants mask `+0x1a8`, player `+0x1b8`) are not written;
// the next hill is the next number in order, as 0x2bd0b0's choice is not
// traced; the type area's other King settings (38, 39, 41, 42, 101) are not
// read.
rules "King of the Hill" 1
carrier king

global var hill: int = 0
global var hills: int = 0
global var moves: timer
player var on_hill: int = 0

fn start_hill(n: int) {
    hill = n
    // Never moves when the setting is 0 (0x2bd747).
    if variant.king_moving_hill > 0 { moves = seconds(variant.king_moving_hill) }
}

on round_start {
    hills = 0
    for each objects labelled "hill_corner" c { hills = max(hills, c.number + 1) }
    for each players p { p.on_hill = 0 }
    start_hill(0)
}

on timer(moves) {
    if hills > 0 { start_hill((hill + 1) % hills) }
}

on tick {
    let zone = first(objects labelled "hill_corner" c where c.number == hill)
    let lead = first(players p where p.alive and inside(p, zone))
    // Contested: someone of another team (or, with no teams, anyone else)
    // is on the hill too.
    let rivals = count(players q where q.alive and inside(q, zone) and ((variant.team_play and q.team != lead.team) or (not variant.team_play and q != lead)))
    for each players p {
        if zone != none and rivals == 0 and p.alive and inside(p, zone) {
            p.on_hill = p.on_hill + 1
            if p.on_hill >= seconds(1) {
                score(p, 1)
                p.on_hill = 0
            }
        } else {
            p.on_hill = 0
        }
    }
}
