// Oddball (engine index 3): balls at the type-4 spawns, a point for each
// second a player holds one, carrier traits, and a dropped ball's reset.
// docs/game/rules-engine.md, "Porting the seven engines".
//
// Entries a host cannot make yet (`verify::unhostable`):
//   spawn_objective  traced (Oddball's ball spawn 0x2bc1f0)
//   role_traits      made only on juggernaut (the engine gives the carrier
//                    traits to whoever holds the ball, 0x2bcc90)
// Not reproduced: the Oddball globals `[0x51ecc4]` (each ball's spawn index)
// are not written; retail takes the ball tag from the globals tag's
// multiplayer block, this script names the path; the reset delay is a
// script option, as retail's is not traced.
rules "Oddball" 1
carrier oddball

option reset_seconds: int 5..60 = 30 "Ball reset" "Seconds a dropped ball lies before it returns"

object var moved: bool = false
object var idle: int = 0
player var held: int = 0
global var placed: int = 0

on round_start {
    placed = 0
    for each players p { p.held = 0 }
    // Retail's init takes at most three type-4 spawns (0x2bc2e0).
    let balls = clamp(variant.oddball_ball_count, 1, 3)
    for each objects labelled "oddball_spawn" s {
        if placed < balls {
            spawn_objective("objects/weapons/multiplayer/ball/ball", s, none)
            placed = placed + 1
        }
    }
}

on pickup(p, o) {
    if is_objective(o) {
        o.moved = true
        o.idle = 0
        role_traits(p, true)
    }
}

on drop(p, o) {
    if is_objective(o) { role_traits(p, false) }
}

on tick {
    for each objectives b {
        let p = b.carrier
        if p != none {
            p.held = p.held + 1
            if p.held >= seconds(1) {
                score(p, 1)
                p.held = 0
            }
        } else if b.moved {
            b.idle = b.idle + 1
            if b.idle >= seconds(reset_seconds) {
                reset_objective(b)
                b.moved = false
                b.idle = 0
            }
        }
    }
}
