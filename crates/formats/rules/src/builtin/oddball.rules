// Oddball (engine index 3): balls at the type-4 spawns, a point for each
// second a player holds one, carrier traits, and a dropped ball's reset.
// docs/game/rules-engine.md, "Porting the seven engines".
//
// Entries a host cannot make yet (`verify::unhostable`):
//   spawn_objective  traced (Oddball's ball spawn 0x2bc1f0)
// Not reproduced: the Oddball globals `[0x51ecc4]` (each ball's spawn index)
// are not written; retail takes the ball tag from the globals tag's
// multiplayer block, this script names the path; the reset delay is a
// script option, as retail's is not traced.
rules "Oddball" 1
type oddball
requires hud.widgets

label oddball_spawn: objects

// The HUD (docs/game/game-types-without-carriers.md, "The display"): the
// ball's holder, the seconds that player has held it and a banner for a
// pickup or a drop. The ball moves, so it has no mark.
hud holder_row: text at odd.holder
hud held_row: text at odd.time
hud ball_row: banner at odd.banner

// Retail's init takes at most three type-4 spawns (0x2bc2e0).
const most_balls = 3

option reset_time: time 5s..60s = 30s "Ball reset" "How long a dropped ball lies before it returns"

object var moved: bool = false
object var idle: time = 0t
player var held: time = 0t
global var placed: int = 0
global var holder: int = -1
global var held_for: time = 0t
global var banner_left: int = 0

on round_start {
    placed = 0
    holder = -1
    held_for = 0t
    hud_show(ball_row, false)
    for each players p { p.held = 0t }
    let balls = clamp(variant.oddball_ball_count, 1, most_balls)
    for each oddball_spawn s {
        if placed < balls {
            spawn_objective("objects/weapons/multiplayer/ball/ball", s, none)
            placed = placed + 1
        }
    }
}

on pickup(p, o) {
    if is_objective(o) {
        o.moved = true
        o.idle = 0t
        role_traits(p, true)
        hud_text(ball_row, "BALL TAKEN")
        hud_show(ball_row, true)
        banner_left = 2
    }
}

on drop(p, o) {
    if is_objective(o) {
        role_traits(p, false)
        hud_text(ball_row, "BALL DROPPED")
        hud_show(ball_row, true)
        banner_left = 2
    }
}

on tick {
    // The banner shows for two ticks; the kit times it from there.
    if banner_left > 0 {
        banner_left = banner_left - 1
        if banner_left == 0 { hud_show(ball_row, false) }
    }
    // The first ball's holder is the one the HUD names.
    let lead_ball = first(objectives o where o.carrier != none)
    if let ball = lead_ball {
        if let who = ball.carrier {
            hud_style(holder_row, 1)
            hud_value(holder_row, 16 + slot_of(who))
            if slot_of(who) == holder { held_for = held_for + 1t } else {
                holder = slot_of(who)
                held_for = 0t
            }
            hud_value(held_row, whole_seconds(held_for))
            hud_show(held_row, true)
        }
    } else {
        hud_style(holder_row, 0)
        holder = -1
        held_for = 0t
        hud_show(held_row, false)
    }
    hud_show(holder_row, true)
    for each objectives b {
        let p = b.carrier
        if p != none {
            p.held = p.held + 1t
            if p.held >= 1s {
                score(p, 1)
                p.held = 0t
            }
        } else if b.moved {
            b.idle = b.idle + 1t
            if b.idle >= reset_time {
                reset_objective(b)
                b.moved = false
                b.idle = 0t
            }
        }
    }
}
