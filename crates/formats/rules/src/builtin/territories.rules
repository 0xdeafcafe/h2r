// Territories (engine index 8): markers (flag type 10, label "territory")
// registered by territory, capture by standing in one uncontested for the
// contest time, an owner per territory, and points for territories held.
// docs/game/rules-engine.md, "Porting the seven engines".
//
// The script owns its territories: it tracks which are in play itself, so
// no retail objective is registered, and the record's type area is zero, so
// the count and contest time are script options.
// Entries a host cannot make yet (`verify::unhostable`): none.
// Not reproduced: the Territories globals (`T=[0x51eccc]`: owners `T+0x70`,
// occupants `T+0x95`) are not written; the marker's territory index is not
// passed as its registration team; a contested or abandoned capture
// starts again rather than decaying; the score interval is a script
// option, as retail's is not traced; setting 99 is not read.
rules "Territories" 1
type territories

// Retail's territory count is 1 to 8 (setting 74).
const most_territories = 8

label territory: zones 1..most_territories

option in_play: int 1..most_territories = 3 "Territories" "How many of the map's territories are in play"
option contest_time: time 1s..30s = 5s "Contest time" "How long a territory is stood in, uncontested, to take it"
option score_time: time 1s..16s = 1s "Score interval" "Time between points for each territory held"

object var owner: player? = none
object var live: bool = false
object var progress: time = 0t
global var placed: int = 0
global var pay: timer

// Someone of another team, or with no teams anyone else.
fn rival(a: player, b: player) -> bool = (variant.team_play and a.team != b.team) or (not variant.team_play and a != b)

on round_start {
    placed = 0
    for each territory m {
        m.live = false
        if placed < in_play {
            m.live = true
            m.owner = none
            m.progress = 0t
            show_area(m, none)
            placed = placed + 1
        }
    }
    pay = score_time
}

on tick {
    for each territory m where m.live {
        if let lead = first(players p where p.alive and inside(p, m)) {
            let rivals = count(players q where q.alive and inside(q, m) and rival(q, lead))
            let owner = m.owner
            let held = owner != none and not rival(owner, lead)
            if rivals > 0 or held {
                m.progress = 0t
            } else {
                m.progress = m.progress + 1t
                if m.progress >= contest_time {
                    m.owner = lead
                    m.progress = 0t
                    show_area(m, lead.team)
                }
            }
        } else {
            m.progress = 0t
        }
    }
}

on timer(pay) {
    for each territory m where m.live {
        if let o = m.owner { score(o, 1) }
    }
    pay = score_time
}

// A stale owner holds nothing (0x2bfa3f checks the owner's salt).
on quit(p) {
    for each territory m where m.owner == p {
        m.owner = none
        show_area(m, none)
    }
}
