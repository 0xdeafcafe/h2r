// Gun Game: every player climbs one weapon ladder, a rung for each kill;
// the first past the top rung wins the round. The weapon progression the
// variant editor cannot express (docs/game/community-gametypes.md).
// docs/game/rules-engine.md, "Payoff".
//
// A kill swaps the killer's weapon for the next rung's at once
// (`set_loadout`, mode 2 empties the slots), and every spawn gives the
// player's own rung, so players spawn unarmed and the map has no weapons.
// Every rung is on the multiplayer weapon list (`rules::weapons`), the only
// weapons `set_loadout` gives. A dropped weapon can still be picked up:
// leaving them is the honour rule it always was.
//
// Entries a host cannot make yet (`verify::unhostable`): none.
rules "Gun Game" 1
carrier slayer
list party
requires player.weapons, hud.message
about "Every kill moves you up the weapon ladder, from the SMG to the energy sword. A kill with the sword wins. Leave dropped weapons where they lie."
quick suicide_demotes, time_limit, respawn_time

settings {
    starting_weapon = none
    secondary_weapon = none
    weapons_on_map = none
    score_limit = none
}

option suicide_demotes: bool = true "Suicide demotes" "A suicide sends the player down one rung"

table ladder: (weapon: weapon) = [
    ("objects/weapons/rifle/smg/smg"),
    ("objects/weapons/rifle/battle_rifle/battle_rifle"),
    ("objects/weapons/rifle/covenant_carbine/covenant_carbine"),
    ("objects/weapons/rifle/plasma_rifle/plasma_rifle"),
    ("objects/weapons/rifle/shotgun/shotgun"),
    ("objects/weapons/rifle/sniper_rifle/sniper_rifle"),
    ("objects/weapons/rifle/beam_rifle/beam_rifle"),
    ("objects/weapons/support_low/brute_shot/brute_shot"),
    ("objects/weapons/support_high/rocket_launcher/rocket_launcher"),
    ("objects/weapons/pistol/needler/needler"),
    ("objects/weapons/pistol/magnum/magnum"),
    ("objects/weapons/melee/energy_blade/energy_blade"),
]

// The top rung; a kill past it wins.
const top = len(ladder) - 1

player var level: int = 0
global var over: bool = false

fn arm(p: player) {
    set_loadout(p, ladder[min(p.level, top)].weapon, none)
}

on round_start {
    over = false
    for each players p { p.level = 0 }
}

on spawn(p) {
    arm(p)
}

on kill(victim, killer) {
    if over {
        // The round is over: a kill after the last climbs nothing.
    } else if killer == none or killer == victim {
        if suicide_demotes and victim.level > 0 { victim.level = victim.level - 1 }
    } else if not (variant.team_play and killer.team == victim.team) {
        killer.level = killer.level + 1
        score(killer, 1)
        if killer.level > top {
            over = true
            message(all, "{killer} finished the ladder")
            end_round(killer.team)
        } else if killer.alive {
            arm(killer)
        }
    }
}
