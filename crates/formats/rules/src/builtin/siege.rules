// Siege (working name): the phased attack-and-defend mode, with the
// mechanics of Halo: Reach's Invasion and none of its assets or text.
// Team 0 attacks, team 1 defends. Phases 0 and 1: hold the phase's zone
// for the capture time and the map opens further (barriers numbered below
// the phase are removed; spawn areas move up). Phase 2: a core appears;
// carrying it into the goal wins. Each phase has its own clock; the
// defenders win when one runs out. Respawns come in waves, and each team
// has its own loadout.
// docs/game/rules-engine.md, "Phases: attack and defend" and "Payoff".
//
// Entries a host cannot make yet (`verify::unhostable`):
//   ticks_held          not built (the VM counts; the host has no zone test)
//   spawn_areas         untraced (the PLAYER_SPAWN_LOCATION rule)
//   create              traced (Forge's creation)
//   register_objective  traced (0x15e050)
//   set_loadout         traced (0x19eda0)
// Not covered: a body per team (Spartan or Elite) has no entry.
rules "Siege" 1
carrier slayer
teams 2
requires objects.create, objects.delete, player.spawn, player.weapons

// The core's phase; the phases before it each have a zone.
const last_phase = 2

// What the map supplies.
label barrier: objects numbered
label attack: spawns numbered 0..last_phase
label defend: spawns numbered 0..last_phase
label capture: zones numbered 0..1 = "zone"
label core: object
label goal: zone

option phase_time: time 60s..600s = 180s "Phase time" "How long the attackers have for each phase"
option capture_time: time 5s..60s = 20s "Capture time" "How long the attackers hold a zone to take it"
option wave_time: time 3s..15s = 8s "Respawn wave" "Time between respawn waves"

table loadouts: (side: team, primary: weapon, secondary: weapon) = [
    (team 0, "objects/weapons/rifle/battle_rifle/battle_rifle", "objects/weapons/pistol/magnum/magnum"),
    (team 1, "objects/weapons/rifle/covenant_carbine/covenant_carbine", "objects/weapons/rifle/plasma_rifle/plasma_rifle"),
]

global var phase: int = 0
global var clock: timer
global var wave: timer

fn open(n: int) {
    phase = n
    clock = phase_time
    for each barrier b where b.number < n { delete(b) }
    spawn_areas(team 0, attack, n)
    spawn_areas(team 1, defend, n)
    if n == last_phase { create("objects/weapons/multiplayer/assault_bomb/assault_bomb", core) }
}

on round_start {
    open(0)
    wave = wave_time
}

on pickup(p, o) {
    if phase == last_phase and p.team == team 0 and not is_objective(o) { register_objective(o, team 0) }
}

on tick {
    if phase < last_phase {
        if let zone = capture[phase] and ticks_held(zone, team 0) >= capture_time { open(phase + 1) }
    }
}

on enter(goal, o) {
    if phase == last_phase and is_objective(o) { end_round(team 0) }
}

on timer(clock) { end_round(team 1) }

// Hold the dead until the wave: no lives, then a respawn for each.
on death(p) { set_lives(p, 0) }

on timer(wave) {
    for each players p where not p.alive { respawn(p) }
    wave = wave_time
}

on spawn(p) {
    let kit = loadouts[p.team]
    set_loadout(p, kit.primary, kit.secondary)
}
