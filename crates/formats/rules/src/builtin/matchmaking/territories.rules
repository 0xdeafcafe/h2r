// Territories: a built-in matchmaking variant of the default Live lineup
// (live_proto::hopper::defaults). The carrier's engine scores the game; the
// settings are the hopper defaults writer's (0x00193010: settings 12 to 14
// cleared) and this variant's own. docs/live/live-matchmaking.md, "6.8 The default set".
rules "Territories" 1
carrier territories
scoring carrier
about "Team Territories."

settings {
    team_play = true
    setting_twelve = false
    setting_thirteen = false
    join_in_progress = 0
}
