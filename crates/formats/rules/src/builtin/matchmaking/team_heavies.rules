// Team Heavies: a built-in matchmaking variant of the default Live lineup
// (live_proto::hopper::defaults). The built-in game it uses scores the
// game; the settings are the hopper defaults writer's (0x00193010: settings 12 to 14
// cleared) and this variant's own. docs/live/live-matchmaking.md, "6.8 The default set".
rules "Team Heavies" 1
type slayer
uses slayer
about "Team Slayer with rocket launchers and rockets on the map."

settings {
    team_play = true
    starting_weapon = rocket_launcher
    secondary_weapon = magnum
    weapons_on_map = rockets
    setting_twelve = false
    setting_thirteen = false
    join_in_progress = 0
}
