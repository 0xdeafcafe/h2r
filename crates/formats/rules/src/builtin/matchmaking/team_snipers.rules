// Team Snipers: a built-in matchmaking variant of the default Live lineup
// (live_proto::hopper::defaults). The built-in game it uses scores the
// game; the settings are the hopper defaults writer's (0x00193010: settings 12 to 14
// cleared) and this variant's own. docs/live/live-matchmaking.md, "6.8 The default set".
rules "Team Snipers" 1
type slayer
uses slayer
about "Team Slayer with sniper rifles: no vehicles, turrets or motion sensor."

settings {
    team_play = true
    motion_sensor = false
    weapons_on_map = sniping
    starting_weapon = sniper_rifle
    secondary_weapon = magnum
    light_vehicle = none
    second_light_vehicle = none
    heavy_vehicle = none
    flying_vehicle = none
    second_heavy_vehicle = none
    primary_turret = none
    secondary_turret = none
    setting_twelve = false
    setting_thirteen = false
    join_in_progress = 0
}
