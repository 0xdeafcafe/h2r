// Hide and Seek: everyone hides with active camo; the Juggernaut seeks.
// `list party` files it under Party Games: a row's list holds Slayer's and
// Juggernaut's variants (docs/game/rules-variants.md).
// docs/game/community-gametypes.md.
rules "Hide and Seek" 1
carrier juggernaut
list party
scoring carrier
about "Everyone hides with active camo and no motion sensor. The Juggernaut seeks with a sword, a motion sensor and extra speed. One life each."
quick time_limit, lives, juggernaut_movement, starting_weapon, active_camo

settings {
    starting_weapon = energy_sword
    secondary_weapon = none
    starting_grenades = false
    weapons_on_map = none
    grenades_on_map = false
    active_camo = true
    motion_sensor = false
    juggernaut_active_camo = false
    juggernaut_motion_sensor = true
    juggernaut_movement = fast
    lives = 1
    time_limit = 300s
}
