// Juggernaut (engine index 7): one Juggernaut, the role passing to whoever
// kills it (0x192970), Juggernaut traits, and scoring by role.
// docs/game/rules-engine.md, "Porting the seven engines".
//
// Entries a host cannot make yet (`verify::unhostable`):
//   role_traits      untraced (it also sets the role mask `[0x510c9c]+0`)
// Not reproduced: who takes the role after a suicide or a quit is not
// traced; this script draws one with the VM's generator. Whether retail
// scores the kill that takes the role is not traced: `take_points` is 0 by
// default, so only the Juggernaut scores.
rules "Juggernaut" 1
carrier juggernaut

option kill_points: int 1..5 = 1 "Juggernaut kill points" "Points for each kill the Juggernaut makes"
option take_points: int 0..3 = 0 "Takeover points" "Points for killing the Juggernaut"

global var juggernaut: player = none

fn crown(p: player) {
    if juggernaut != none { role_traits(juggernaut, false) }
    juggernaut = p
    if p != none { role_traits(p, true) }
}

on round_start {
    juggernaut = none
    for each pick(players, 1) p { crown(p) }
}

on kill(victim, killer) {
    if victim == juggernaut {
        if killer != none and killer != victim {
            if take_points > 0 { score(killer, take_points) }
            crown(killer)
        } else {
            for each pick(players, 1) p { crown(p) }
        }
    } else if killer != none and killer == juggernaut and killer != victim {
        score(killer, kill_points)
    }
}

on quit(p) {
    if p == juggernaut { juggernaut = none }
}

// A quit leaves no Juggernaut; the next tick names one.
on tick {
    if juggernaut == none and count(players) > 0 {
        for each pick(players, 1) p { crown(p) }
    }
}
