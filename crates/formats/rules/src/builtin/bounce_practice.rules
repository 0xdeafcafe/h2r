// Bounce Practice: the community's practice variant, settings only. The
// game scores it as Slayer does; `bounce_hunt.rules` is the bounce-scoring
// example, and Superbounce is the list's bounce-scoring game.
// docs/game/community-gametypes.md.
rules "Bounce Practice" 1
carrier slayer
list research
scoring carrier
about "Practice super bounces and crouch jumps with a magnum: no score, no time limit, tough players, quick respawns and nothing to pick up."
quick respawn_time, starting_weapon, shields, damage_resistance, time_limit

settings {
    score_limit = none
    time_limit = none
    respawn_time = 3s
    suicide_penalty = 0s
    shields = overshields
    damage_resistance = true
    starting_weapon = magnum
    secondary_weapon = none
    weapons_on_map = none
    grenades_on_map = false
}
