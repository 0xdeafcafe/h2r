// Infection: zombies on team 1, humans on team 0; a zombie's kill turns
// the victim, and the round ends when no human is left or the time runs
// out. Honour rules made real (docs/game/community-gametypes.md, Zombies).
// docs/game/rules-engine.md, "Payoff".
//
// Entries a host cannot make yet (`verify::unhostable`):
//   set_team         untraced (player `+0xc0`, no entry known)
//   set_loadout      traced (0x19eda0)
rules "Infection" 1
carrier slayer
teams 2
requires player.team, player.weapons

option first_zombies: int 1..4 = 1 "First zombies" "Players infected at the start of a round"

player var infected: bool = false

fn infect(p: player) {
    p.infected = true
    set_team(p, team 1)
    set_loadout(p, "objects/weapons/melee/energy_blade/energy_blade", none)
}

on round_start {
    for each players p {
        p.infected = false
        set_team(p, team 0)
    }
    for each pick(players, first_zombies) p { infect(p) }
}

on kill(victim, killer) {
    if killer != none and killer.infected and not victim.infected {
        infect(victim)
        score(killer, 1)
    }
}

on tick {
    if count(players where not infected) == 0 { end_round(team 1) }
    else if round_time_left() == 0 { end_round(team 0) }
}
