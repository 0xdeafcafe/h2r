// SWAT: no shields, battle rifles and magnums.
// docs/game/community-gametypes.md.
rules "SWAT" 1
carrier slayer
scoring carrier
about "No shields, no motion sensor, battle rifles and magnums. One headshot kills. 50 points to win."
quick score_limit, time_limit, starting_weapon, secondary_weapon, shields

settings {
    team_play = true
    shields = none
    motion_sensor = false
    starting_weapon = battle_rifle
    secondary_weapon = magnum
    weapons_on_map = none
    grenades_on_map = false
    starting_grenades = false
    overshield_pickups = false
    camo_pickups = false
    score_limit = 50
}
